{
  "name": "halil-tanisan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,green \"vite\" \"npm:dev:server\"",
    "dev:vite": "vite",
    "dev:server": "node --env-file=.env server/index.js",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file=.env server/index.js",
    "setup-admin": "node scripts/setup-admin.mjs",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
